#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

start_service() {
	local enabled="$(uci -q get akile-ddns.main.enabled || uci -q get akile-ddns.@global[0].enabled || echo 0)"
	if [ "$enabled" != "1" ]; then
		return 0
	fi

	procd_open_instance "akile-ddns"
	procd_set_param command /usr/bin/akile-ddns run
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	rm -f /var/run/akile-ddns.pid /var/run/akile-ddns.status /var/run/akile-ddns.lastip
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "akile-ddns"
}
