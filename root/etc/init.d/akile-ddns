#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

EXTRA_COMMANDS="check status"
EXTRA_HELP="	check	Trigger an immediate IP check and update"

start_service() {
	local enabled
	config_load 'akile-ddns'
	config_get_bool enabled 'main' 'enabled' '0'
	[ "$enabled" -eq 1 ] || return 0

	procd_open_instance "akile-ddns"
	procd_set_param command /usr/bin/akile-ddns run
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	/usr/bin/akile-ddns status >/dev/null 2>&1
	killall -9 akile-ddns 2>/dev/null
	rm -f /var/run/akile-ddns.pid /var/run/akile-ddns.status
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "akile-ddns"
}

check() {
	/usr/bin/akile-ddns check
}
