{
	"luci-app-akile-ddns": {
		"description": "Grant UCI, file and execution access for luci-app-akile-ddns",
		"read": {
			"uci": [ "akile-ddns" ],
			"file": {
				"/var/run/akile-ddns.status": [ "read" ],
				"/var/run/akile-ddns.lastip": [ "read" ],
				"/var/log/akile-ddns.log": [ "read" ]
			}
		},
		"write": {
			"uci": [ "akile-ddns" ],
			"file": {
				"/etc/init.d/akile-ddns": [ "exec" ],
				"/usr/bin/akile-ddns": [ "exec" ]
			}
		}
	}
}
